# Enterprise Agentic Bridge — every value here has a working default.
# Copy to .env only if you need to override something.

# Transport. Studio uses stdio; NitroCloud/ChatGPT use http.
# Defaults to stdio, or http when NODE_ENV=production.
# BRIDGE_TRANSPORT=stdio
# PORT=8080
# HOST=0.0.0.0

# Extra directories the swarm is allowed to read, ':'-separated.
# The project root and the bundled fixture are always allowed.
# BRIDGE_ALLOWED_ROOTS=/Users/you/work/legacy-monolith

# Set to false to disable runtime skill minting entirely.
# BRIDGE_ALLOW_SKILL_GENERATION=true

# debug | info | warn | error
# LOG_LEVEL=info

# OPTIONAL. The CLAUDE.md manifest is generated deterministically with zero LLM
# calls and is correct without this. Set it only to enable narrative enrichment.
# ANTHROPIC_API_KEY=
