# Enterprise Agentic Bridge — every value here has a working default.
# Copy to .env only if you need to override something.
#
# The bridge boots and demos with none of these set. Each section below adds a
# capability; nothing here is required to run the swarm, resolve a conflict or
# generate CLAUDE.md.

# ─────────────────────────────────────────────────────────────────────────────
# Transport
# ─────────────────────────────────────────────────────────────────────────────
# stdio | http | dual. Studio spawns stdio; NitroCloud, the ChatGPT connector
# and the admin dashboard use http. Defaults to stdio, or http in production.
# BRIDGE_TRANSPORT=stdio
# PORT=8080
# HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────────────────────
# Remote security
# ─────────────────────────────────────────────────────────────────────────────
# Until one of these is set, authentication is OFF and every tool is reachable.
# That is the right default for stdio on a laptop and the wrong one the moment
# the HTTP transport is listening — the `security` health check reports
# "degraded" in exactly that case.
#
# Once set, the state-mutating tools (run_swarm, synthesize_claude_md,
# resolve_conflict, detect_conflicts, generate_custom_skill,
# ingest_manual_document, save_pipeline, run_pipeline, reset_bridge) require a
# credential. Read-only tools stay open.
#
# One key, or a comma-separated list to rotate. `label:secret` keeps the audit
# log readable.
# BRIDGE_ADMIN_API_KEY=dashboard:s3cr3t,ci:an0ther

# HS256/384/512 shared secret, for bearer tokens instead of (or alongside) keys.
# BRIDGE_JWT_SECRET=
# BRIDGE_JWT_ISSUER=
# BRIDGE_JWT_AUDIENCE=

# mutations (default) protects the state-changing tools; all requires a
# credential for every request to /mcp, including reads.
# BRIDGE_AUTH_SCOPE=mutations

# Max JSON request body. The default is 50mb so a multi-year Jira export or a
# large PDF can be ingested in one call; NitroStack's own default is 100kb.
# BRIDGE_JSON_BODY_LIMIT=50mb

# ─────────────────────────────────────────────────────────────────────────────
# Live enterprise data (Jira + Slack)
# ─────────────────────────────────────────────────────────────────────────────
# The Product Synchronizer and Scrum Analyst read real systems when these are
# set. With none of them set the bridge still works: it returns the bundled
# Aurora fixtures and marks every response `dataSource: "fixture"` with a hint
# naming the variables to set. It never silently passes mock data off as real.
#
#   auto    (default) live where configured, fixture otherwise and on failure
#   live    live only — a missing or broken integration is an error
#   fixture never touch the network
# BRIDGE_DATA_MODE=auto

# fetch_sprint_goals — Jira Agile REST, basic auth with an API token.
# Token: id.atlassian.com → Security → API tokens.
# JIRA_BASE_URL is shared with the update_jira pipeline effect below;
# JIRA_DOMAIN is accepted as an alias if you prefer a bare hostname.
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@your-org.com
# JIRA_API_TOKEN=
# Pin a board, otherwise the first board visible to the account is used.
# JIRA_BOARD_ID=42
# JIRA_PROJECT_KEY=AUR
# Story points live in a per-site custom field; override if yours differs.
# JIRA_STORY_POINTS_FIELD=customfield_10016

# fetch_meeting_transcripts — Slack. Create a bot at api.slack.com/apps with
# channels:history (plus groups:history for private channels) and users:read,
# invite it to the channel, then use its xoxb- token. SLACK_CHANNEL_ID is the
# C… id from the channel's "Copy link".
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123456789
# SLACK_MESSAGE_LIMIT=50

# Who outranks whom when a spoken decision conflicts with a ticket. Matched
# case-insensitively against the speaker name. Without these, only the bundled
# fixture's names are recognised as authoritative.
# BRIDGE_AUTHORITY_LEADS=d.fairbanks,dave
# BRIDGE_AUTHORITY_OPS=k.brandt

# ─────────────────────────────────────────────────────────────────────────────
# Filesystem boundary and remote repositories
# ─────────────────────────────────────────────────────────────────────────────
# Every tool that takes a `target` accepts a GitHub URL as well as a local
# path — https://github.com/<owner>/<repo>, optionally /tree/<branch>. Remote
# targets are shallow-cloned into a private temp directory, analysed, and
# deleted when the call returns. This is what lets the bridge run in the cloud
# and still analyse a real codebase: it never needs the caller's local disk.
# Requires git on PATH (2.31+ for the token-passing mechanism).

# Extra local directories the swarm is allowed to read, ':'-separated.
# The project root and the bundled fixture are always allowed.
# BRIDGE_ALLOWED_ROOTS=/Users/you/work/legacy-monolith

# Git hosts that may be cloned from, comma-separated. Defaults to github.com.
# BRIDGE_ALLOWED_REPO_HOSTS=github.com

# Needed only for private repositories. Passed to git via GIT_CONFIG_* in the
# environment rather than in the URL or argv, so it does not leak to `ps`.
# Shared with the deploy pipeline effect below.
# GITHUB_TOKEN=

# Abort a clone that outruns this. The default suits repositories up to a few
# hundred MB on a normal connection.
# BRIDGE_CLONE_TIMEOUT_MS=120000

# Set to false to disable runtime skill minting entirely.
# BRIDGE_ALLOW_SKILL_GENERATION=true

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline side effects
# ─────────────────────────────────────────────────────────────────────────────
# The side-effecting stages only fire when run_pipeline is called with
# execute_side_effects=true AND the integration below is configured. With
# neither, every such stage reports the command it would have issued.

# run_tests — overrides the command discovered from package.json / pytest / maven.
# BRIDGE_TEST_COMMAND=npm test
# BRIDGE_COMMAND_TIMEOUT_MS=600000

# push — the remote and branch to push to. Pushing to master/main/develop/
# release/production is refused unless the override is set.
# BRIDGE_GIT_REMOTE=origin
# BRIDGE_GIT_BRANCH=
# BRIDGE_GIT_ALLOW_PROTECTED=false

# deploy — GitHub Actions is tried first, then Jenkins.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
# GITHUB_WORKFLOW=pr-checks.yml
# GITHUB_REF=main
# JENKINS_URL=https://jenkins.internal
# JENKINS_JOB=aurora-billing
# JENKINS_USER=
# JENKINS_API_TOKEN=

# update_jira — Jira Cloud REST v3, basic auth with an API token. Uses the same
# JIRA_BASE_URL / JIRA_EMAIL / JIRA_API_TOKEN as the live sprint read above.
# BRIDGE_JIRA_TRANSITION=In Review

# send_slack_message — an incoming webhook URL. Separate from SLACK_BOT_TOKEN
# above: that one reads a channel, this one posts to it.
# SLACK_WEBHOOK_URL=

# Outbound HTTP timeout for all of the above.
# BRIDGE_HTTP_TIMEOUT_MS=20000

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
# debug | info | warn | error
# LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# LLM reasoning (via OpenRouter)
# ─────────────────────────────────────────────────────────────────────────────
# Get a free key at https://openrouter.ai/keys (starts with `sk-or-…`).
# With this set, each of the 7 swarm personas makes a real LLM call to produce
# reasoned insights on top of the deterministic parser output, and the master
# orchestrator authors the executive briefing that opens CLAUDE.md.
# Without it, the swarm degrades gracefully to deterministic-only.
# OPENROUTER_API_KEY=

# Which model each persona / the orchestrator uses. Default is the free
# DeepSeek R1 tier (20 req/min, $0 cost). Other examples:
#   anthropic/claude-3.5-sonnet
#   google/gemini-2.5-pro
#   openai/gpt-4o-mini
# Full catalogue at https://openrouter.ai/models
# BRIDGE_LLM_MODEL=deepseek/deepseek-r1:free

# Reasoning effort hint. Not every model honours it.
# BRIDGE_LLM_EFFORT=high

# Set false to disable LLM reasoning even when a key is present.
# BRIDGE_LLM_ENABLED=true
