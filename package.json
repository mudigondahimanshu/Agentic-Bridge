{
  "name": "agentic-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Agentic Bridge — an MCP swarm that translates a legacy codebase into machine-readable context",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "author": "Team",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
